<UserControl x:Class="GoldDigger.View.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GoldDigger.View"
             xmlns:vm="clr-namespace:GoldDigger.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <!-- Converter Bool Visibility -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- Grid zum Zentrieren der Login-Karte -->
    <Grid>

        <!-- Weiße "Login-Karte"-->
        <Border Width="350" Background="White" CornerRadius="10" 
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#E0E0E0" BorderThickness="1" Padding="25">

            <StackPanel>

                <!-- Header -->
                <TextBlock Text="Login" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <!-- Benutzername -->
                <TextBlock Text="Benutzername" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,3"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Height="32" Padding="5" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                <!-- Passwort  -->
                <TextBlock Text="Passwort" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,3"/>
                <PasswordBox x:Name="txt_password" PasswordChanged="PasswordBox_PasswordChanged" Height="32" Padding="5" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                <!-- PASSWORT BESTÄTIGEN (Wird nur im Registrierungs-Modus eingeblendet!) -->
                <StackPanel Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Passwort wiederholen" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,3"/>
                    <PasswordBox x:Name="txt_confirmPassword" PasswordChanged="ConfirmPasswordBox_PasswordChanged" Height="32" Padding="5" Margin="0,0,0,15" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Login Button (automatisch ausgeblendet, sobald IsRegisterMode auf true springt) -->
                <Button Content="Einloggen" Command="{Binding LoginCommand}"
                        Height="36" Background="#1ABC9C" Foreground="White" FontWeight="Bold" 
                        Cursor="Hand" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <!-- Wenn IsRegisterMode true, Button sichtbar -->
                                <DataTrigger Binding="{Binding IsRegisterMode}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Registrieren / Absenden Button -->
                <Button Content="Registrieren" Command="{Binding RegisterCommand}" 
                        Height="32" Background="#34495E" Foreground="White" FontWeight="SemiBold" Cursor="Hand"
                        HorizontalAlignment="Stretch" Margin="0,0,0,5"/>

                <!-- Zurück-Button (Nur im Registrierungs-Modus sichtbar, um abzubrechen) -->
                <Button Content="Zurück zum Login" Command="{Binding CancelRegisterCommand}"
                        Visibility="{Binding IsRegisterMode, Converter={StaticResource BoolToVis}}"
                        Height="28" Background="Transparent" Foreground="#7F8C8D" BorderBrush="Transparent"
                        Cursor="Hand" HorizontalAlignment="Center" Margin="0,5,0,0"/>

                <!-- Fehlermeldungen -->
                <Label Content="{Binding ErrorMessage}" 
                       Foreground="#E74C3C"
                       HorizontalContentAlignment="Center" 
                       FontSize="12" Height="30" Margin="0,5,0,0"/>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>