<Window x:Class="GoldDigger.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoldDigger.View"
        xmlns:vm="clr-namespace:GoldDigger.ViewModel"
        mc:Ignorable="d"
        Title="GoldDigger - Kundenverwaltung" Height="550" Width="950"
        ResizeMode="CanResize">

    <!-- BooleanToVisibilityConverter für das Umschalten der Ansichten -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <!-- DATACONTEXT -->
    <Window.DataContext>
        <vm:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="202"/>
            <ColumnDefinition Width="38"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER / TITEL -->
        <Border Grid.ColumnSpan="3" Grid.Row="0" Background="#2C3E50" Padding="15">
            <DockPanel>
                
                <TextBlock Text="Dashboard" Foreground="White" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding UserMessage}" Foreground="#1ABC9C" FontSize="14" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
           
            </DockPanel>
        </Border>

        <!-- LEFT MENU -->
        <Border Grid.Column="0" Grid.Row="1" Background="#1E272E" Padding="15" Grid.ColumnSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Top buttons  (Binding isMenuEnabled) -->
                <StackPanel Grid.Row="0">
                    
                    <Button Content="Kundendaten anzeigen" Command="{Binding ShowCustomersViewCommand}" 
                    IsEnabled="{Binding IsMenuEnabled}"
                    Height="35" Margin="0,0,0,20" HorizontalContentAlignment="Left" Padding="10,0"
                    Background="#34495E" Foreground="White" FontWeight="Bold"/>

                    <TextBlock Text="AKTIONEN" Foreground="#1ABC9C" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>

                    <Button Content="Neukunde anlegen" Command="{Binding ShowNewCustomerViewCommand}" 
                    IsEnabled="{Binding IsMenuEnabled}"
                    Height="35" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="10,0"/>
                    
                    <Button Content="Kundendaten bearbeiten" 
                    IsEnabled="{Binding IsMenuEnabled}"
                    Height="35" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="10,0"/>

                    <Button Content="Kunde löschen" 
                    Command="{Binding CustomersVM.DeleteCustomerCommand}"
                    IsEnabled="{Binding IsMenuEnabled}"
                    Height="35" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="10,0"/>

                </StackPanel>

                <!-- Low Button: Beenden (always visible -->
                <StackPanel Grid.Row="1">
                    <Separator Background="#34495E" Margin="0,10"/>
                    <Button Command="{Binding ExitApplicationCommand}" Content="Beenden" Background="#1ABC9C" Foreground="White" Height="35" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SECTION / CONTENT (Alle Ansichten exakt nach dem Vorbild eingebunden) -->

        <!--  LOGIN VIEW -->
        <ContentControl Grid.Column="2" Grid.Row="1" Margin="15" 
                    Visibility="{Binding IsLoginVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:Login DataContext="{Binding LoginVM}" />
        </ContentControl>

        <!--  KUNDENÜBERSICHT (Default View after successful login)-->
        <ContentControl Grid.Column="2" Grid.Row="1" Margin="15"
                    Visibility="{Binding IsCustomersVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:Customers DataContext="{Binding CustomersVM}" />
        </ContentControl>

        <!-- NEUKUNDE -->
        <ContentControl Grid.Column="2" Grid.Row="1" Margin="15"
                Visibility="{Binding IsNewCustomerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:NewCustomer DataContext="{Binding NewCustomerVM}" />
        </ContentControl>


    </Grid>
</Window>