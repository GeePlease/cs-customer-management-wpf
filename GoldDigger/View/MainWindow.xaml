<Window x:Class="GoldDigger.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GoldDigger.View"
        xmlns:vm="clr-namespace:GoldDigger.ViewModel"
        mc:Ignorable="d"
        Title="GoldDigger - Kundenverwaltung" Height="550" Width="950"
        ResizeMode="CanResize">

    <!-- BooleanToVisibilityConverter für das Umschalten der Ansichten -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <!-- DATACONTEXT -->
    <Window.DataContext>
        <vm:MainWindow />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="202"/>
            <ColumnDefinition Width="38"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER / TITEL (Spanne über alle Spalten, exklusiv in Zeile 0) -->
        <Border Grid.ColumnSpan="3" Grid.Row="0" Background="#2C3E50" Padding="15">
            <DockPanel>
                <!-- Titel links -->
                <TextBlock Text="Dashboard" Foreground="White" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center"/>

                <!-- Willkommensnachricht / UserMessage jetzt fest oben im Header rechts -->
                <TextBlock Text="{Binding UserMessage}" Foreground="#1ABC9C" FontSize="14" FontWeight="SemiBold" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- LEFT MENU (Spalte 0 & 1, Zeile 1) - Gesteuert über IsMenuEnabled -->
        <Border Grid.Column="0" Grid.Row="1" Background="#1E272E" Padding="15" Grid.ColumnSpan="2">
            <Grid IsEnabled="{Binding IsMenuEnabled}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Haupt-Navigation (Oben im Menü) -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="AKTIONEN" Foreground="#1ABC9C" FontSize="14" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Button Content="Neukunde anlegen" Height="35" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="10,0"/>
                    <Button Content="Kundendaten bearbeiten" Height="35" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="10,0"/>
                    <Button Content="Kunde löschen" Height="35" Margin="0,0,0,8" HorizontalContentAlignment="Left" Padding="10,0"/>
                </StackPanel>

                <!-- Abgesetzter Beenden-Button (Unten im Menü) -->
                <StackPanel Grid.Row="1">
                    <Separator Background="#34495E" Margin="0,10"/>
                    <Button Command="{Binding ExitApplicationCommand}" Content="Beenden" Background="#1ABC9C" Foreground="White" Height="35" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SECTION / CONTENT (Spalte 2, Zeile 1 - Bleibt strikt unter dem Header) -->
        <Grid Grid.Column="2" Grid.Row="1" Margin="15">

            <!-- 1. LOGIN ANSICHT (Wird angezeigt, solange der Benutzer nicht eingeloggt ist) -->
            <ContentControl Content="{Binding LoginVM}"
                            Visibility="{Binding IsLoginVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <local:Login/>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
                
            </ContentControl>

            <!-- NEUKUNDE-->
            <ContentControl Visibility="{Binding IsNewCustomerVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!-- Hier steht kein Text mehr drin, der Text wandert komplett in die UserMessage im Header -->
                <TextBlock Text="" />
            </ContentControl>

            <!-- KUNDENDATEN BEARBEITEN -->
            <ContentControl Visibility="{Binding IsEditVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </ContentControl>

            <!-- KUNDE LÖSCHEN -->
            <ContentControl Visibility="{Binding IsDeleteVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </ContentControl>

        </Grid>
    </Grid>
</Window>