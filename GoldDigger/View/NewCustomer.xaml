<UserControl x:Class="GoldDigger.View.NewCustomer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.openxmlformats.org/expression/blend/2008" 
             xmlns:local="clr-namespace:GoldDigger.View"
             xmlns:vm="clr-namespace:GoldDigger.ViewModel"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="800">

    <Grid Background="#FFF7FAFC">
        <Border Background="White" CornerRadius="10" Margin="15" Padding="20"
                BorderBrush="#E0E0E0" BorderThickness="1">

            <!-- Formular-Inhalt zentrierter Block -->
            <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- Überschrift / Titel -->
                <TextBlock Text="Neukunde anlegen" FontSize="20" FontWeight="Bold" Foreground="#2C3E50" Margin="0,0,0,15"/>

                <!-- Vorname & Nachname -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Vorname" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,2" FontSize="11"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="4" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Nachname" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,2" FontSize="11"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="4" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Straße & Hausnummer -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="1.2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Straße" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,2" FontSize="11"/>
                        <TextBox Text="{Binding Street, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="4" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Hausnummer" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,2" FontSize="11"/>
                        <TextBox Text="{Binding StreetNumber, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="4" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- PLZ & Wohnort -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="15" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="PLZ" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,2" FontSize="11"/>
                        <TextBox Text="{Binding PostCode, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="4" VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Wohnort" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,2" FontSize="11"/>
                        <TextBox Text="{Binding Residence, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="4" VerticalContentAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- E-Mail (volle Breite) -->
                <TextBlock Text="E-Mail" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,2" FontSize="11"/>
                <TextBox Text="{Binding Mail, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="4" Margin="0,0,0,15" VerticalContentAlignment="Center"/>

                <!-- Anlegen Button -->
                <Button Content="Anlegen" Command="{Binding CreateNewCustomerCommand}"
                        Height="35" Background="#1ABC9C" Foreground="White" FontWeight="Bold" 
                        Cursor="Hand" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>

                <!-- Feedback Label -->
                <Label Content="{Binding Message}" 
                       Foreground="#2C3E50" Height="35" 
                       HorizontalContentAlignment="Center" 
                       FontSize="12" Padding="0"/>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>